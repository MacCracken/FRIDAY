# Dockerfile.dev — Rust + Dashboard build on AGNOS base
#
# Builder 1: Rust (compiles sy-core binary)
# Builder 2: Node (compiles dashboard SPA only)
# Runtime: ghcr.io/maccracken/agnosticos:2026.3.31 (LLM Gateway + Agent Runtime)
#
# No Node.js in the runtime image. sy-core is the sole application process.
#
# Used by docker-compose.yml for local docker compose up.

# Build args (must be before FROM to be usable in FROM lines)
ARG NODE_IMAGE=node:22-alpine

# ---- rust builder ----
FROM rust:1.91 AS rust-builder

RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace manifests for layer caching
COPY crates/Cargo.toml crates/Cargo.toml
COPY crates/sy-crypto/Cargo.toml crates/sy-crypto/Cargo.toml
COPY crates/sy-hwprobe/Cargo.toml crates/sy-hwprobe/Cargo.toml
COPY crates/sy-tee/Cargo.toml crates/sy-tee/Cargo.toml
COPY crates/sy-privacy/Cargo.toml crates/sy-privacy/Cargo.toml
COPY crates/sy-audit/Cargo.toml crates/sy-audit/Cargo.toml
COPY crates/sy-sandbox/Cargo.toml crates/sy-sandbox/Cargo.toml
COPY crates/sy-edge/Cargo.toml crates/sy-edge/Cargo.toml
COPY crates/sy-types/Cargo.toml crates/sy-types/Cargo.toml
COPY crates/sy-core/Cargo.toml crates/sy-core/Cargo.toml

# Create stub lib.rs files for dependency caching
RUN for d in sy-crypto sy-hwprobe sy-tee sy-privacy sy-audit sy-sandbox sy-edge sy-types; do \
      mkdir -p crates/$d/src && echo "" > crates/$d/src/lib.rs; \
    done && \
    mkdir -p crates/sy-core/src && echo "fn main() {}" > crates/sy-core/src/main.rs

# Pre-fetch and compile dependencies (cached layer)
RUN cd crates && cargo build --release -p sy-core 2>/dev/null || true

# Copy actual source
COPY crates/ crates/

# Build sy-core binary
RUN cd crates && cargo build --release -p sy-core && \
    cp target/release/sy-core /build/sy-core

# ---- dashboard builder ----
FROM ${NODE_IMAGE} AS dashboard-builder

WORKDIR /app

# Copy workspace manifests for layer caching — include core's package.json
# for transitive type deps (@types/node), but we don't build core.
COPY .npmrc package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/dashboard/package.json packages/dashboard/

RUN npm install --ignore-scripts --include=optional

COPY tsconfig.json ./
COPY packages/shared/ packages/shared/
COPY packages/dashboard/ packages/dashboard/

# Build shared + dashboard only (core is Rust now)
RUN npm run build --workspace=@secureyeoman/shared && \
    npm run build --workspace=@secureyeoman/dashboard

# ---- runtime ----
FROM ghcr.io/maccracken/agnosticos:2026.3.31

USER root

# Runtime deps — NO Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    gettext-base \
    supervisor \
    postgresql-17 postgresql-17-pgvector gosu \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1001 secureyeoman && useradd -u 1001 -g secureyeoman -G agnos -d /home/secureyeoman -m secureyeoman \
 && mkdir -p /home/secureyeoman/.secureyeoman/data /home/secureyeoman/.secureyeoman/workspace \
 && chown -R secureyeoman:secureyeoman /home/secureyeoman \
 && mkdir -p /usr/share/secureyeoman/community-repo \
 && chown -R secureyeoman:secureyeoman /usr/share/secureyeoman \
 && chown -R secureyeoman:agnos /run/agnos /var/lib/agnos /var/log/agnos /etc/agnos

# Install Caddy static binary
RUN curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=amd64" -o /usr/local/bin/caddy \
 && chmod +x /usr/local/bin/caddy

ENV COMMUNITY_REPO_PATH=/usr/share/secureyeoman/community-repo

# Copy the sy-core binary
COPY --from=rust-builder /build/sy-core /usr/local/bin/secureyeoman
RUN chmod +x /usr/local/bin/secureyeoman

# SQL migration files (if they exist — ignore if not present)
COPY dist/migration[s]/ /usr/local/bin/migrations/

# Dashboard SPA (served by sy-core via static file serving)
COPY --from=dashboard-builder /app/packages/dashboard/dist /usr/share/secureyeoman/dashboard/

# Embedded PostgreSQL config
COPY docker/postgresql.conf /etc/postgresql/postgresql.conf
RUN mkdir -p /etc/postgresql /var/lib/postgresql/data /run/postgresql \
 && chown -R postgres:postgres /var/lib/postgresql /run/postgresql /etc/postgresql

# Supervisord + Caddy config
COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/Caddyfile.template /etc/caddy/Caddyfile.template
RUN mkdir -p /var/log/supervisor /etc/caddy /data/caddy \
 && chown -R secureyeoman:secureyeoman /etc/caddy /data/caddy /var/log/supervisor

# Combined entrypoint: configures TLS + supervisord
COPY docker/entrypoint-combined.sh /usr/local/bin/entrypoint-combined.sh
RUN chmod +x /usr/local/bin/entrypoint-combined.sh

# Use JSON log format
ENV SECUREYEOMAN_LOG_FORMAT=json

EXPOSE 18789 443 5432 8088 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["curl", "-sf", "http://127.0.0.1:18789/health"]

# Entrypoint runs as root for PG init; supervisord drops to secureyeoman/postgres per program.
ENTRYPOINT ["tini", "--", "/usr/local/bin/entrypoint-combined.sh"]
CMD ["secureyeoman", "start"]
