[package]
name = "yeo-cy-test"
version = "0.1.0"
description = "yeo-cy-test — Cyrius full-stack viability probe for the SecureYeoman port"
license = "AGPL-3.0-only"
language = "cyrius"
cyrius = "6.1.15"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "yeo-cy-test"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "net", "result", "tagged", "json", "freelist", "chrono", "thread", "atomic"]

[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.2.6"
modules = ["dist/sakshi.cyr"]

[deps.patra]
git = "https://github.com/MacCracken/patra.git"
tag = "1.10.3"
modules = ["dist/patra.cyr"]
