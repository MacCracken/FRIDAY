# yeo-cy-test — top-level test entry (referenced by cyrius.cyml [build].test).
#
# Two invariants the app relies on:
#   1. patra bound-text storage (1.11.2): a note body in a TEXT column written
#      through a bound `?` param stores/reads byte-for-byte and never reparses
#      as SQL (injection-safe).
#   2. httpd route_match: `:name` path-param matching — segment-count rules,
#      capture, and numeric parsing — the routing the /api/notes/:id resource
#      depends on.
#   3. libro audit chain: appends build a hash-linked chain that verifies and
#      whose head hash advances per entry — the tamper-evidence the sy-core
#      `audit` module (src/audit.cyr) is built on.
#   4. ai-hwaccel detection: registry_detect_no_exec() → registry_to_summary_json
#      produces a non-empty JSON summary — the sy-core `hwprobe` module
#      (src/hwprobe.cyr) integration.
#   5. sigil crypto: an Ed25519 sign→verify round-trip (tamper is rejected) and a
#      SHA-256 known-answer (RFC 6234 vector, independent of the impl) — the sy-core
#      `crypto` module (src/crypto.cyr) integration.
#   6. auth JWT: an HS256 issue→verify round-trip returns the subject; a tampered
#      token and an expired token are both rejected — the sy-core `auth` module
#      (src/auth.cyr) integration.
#   7. key persistence: crypto_key_save → crypto_key_load round-trips 32 bytes at
#      rest (through tee sealing), and a missing file loads as absent.
#   8. tee sealing: AES-256-GCM tee_seal → tee_unseal round-trips, and a tampered
#      ciphertext/tag/IV is rejected — the sy-core `tee` module (src/tee.cyr).
#   9. auth credentials: passwords verify by re-deriving **Argon2id** (sigil 3.12.0,
#      sy-core's m=19456/t=2/p=1) and constant-time comparing the tag — a wrong/empty/
#      off-by-one-byte password is rejected, and the right password under the WRONG salt
#      is rejected (the salt is bound into the tag). No plaintext compare remains.

include "src/httpd.cyr"
include "src/tee.cyr"
include "src/crypto.cyr"
include "src/auth.cyr"

# Returns 0 on pass, non-zero on failure.
fn test_bind_text_verbatim_and_safe(): i64 {
    fl_init();
    patra_init();

    var db = patra_open("yeo-test.patra");
    if (db == 0) { return 1; }

    # Fresh table each run (ignore DROP error on first run).
    patra_exec(db, "DROP TABLE t");
    if (patra_exec(db, "CREATE TABLE t (id INT, body TEXT)") != PATRA_OK) { return 2; }

    # A body that would inject or truncate if inlined as a SQL literal, plus
    # unicode and a length past the old 256-byte STR cap.
    var s = "O'Brien'; DROP TABLE t-- café ☕ \"quoted\"";
    var slen = strlen(s);

    var stmt = patra_prepare(db, "INSERT INTO t VALUES (?, ?)");
    if (stmt == 0) { return 3; }
    patra_bind_int(stmt, 0, 1);
    patra_bind_text(stmt, 1, s, slen);
    if (patra_exec_prepared(db, stmt) != PATRA_OK) { patra_finalize(stmt); return 4; }
    patra_finalize(stmt);

    # Table must still exist with exactly one row (the `DROP TABLE t--` in the
    # body was stored as data, not executed).
    var rs = patra_query(db, "SELECT id, body FROM t");
    if (rs == 0) { return 5; }
    if (patra_result_count(rs) != 1) { patra_result_free(rs); return 6; }

    # Body round-trips byte-for-byte.
    var blen = patra_result_get_text_len(rs, 0, 1);
    if (blen != slen) { patra_result_free(rs); return 7; }
    var buf = alloc(blen + 1);
    patra_result_read_text(db, rs, 0, 1, buf);
    if (memeq(buf, s, slen) == 0) { patra_result_free(rs); return 8; }
    patra_result_free(rs);

    return 0;
}

# cstring equality (both NUL-terminated; case-sensitive). Lived in httpd.cyr for
# the probe's old method-match dispatch; that dispatch is now sandhi's, so this
# test is the only remaining consumer and owns the helper.
fn _cstr_eq(a, b): i64 {
    var i = 0;
    while (load8(a + i) != 0 && load8(b + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return load8(a + i) == load8(b + i);
}

# A captured param (sandhi route params) equals the given cstring?
fn param_eq(params, idx, expect): i64 {
    return _cstr_eq(sandhi_route_param(params, idx), expect);
}

# Returns 0 on pass, non-zero (case code) on failure. Validates sandhi 1.6.7's
# route matcher against the cases the /api/notes/:id resource depends on. (The
# probe's own route_match — now retired in favor of sandhi's — was the reference
# shape for this milestone; this keeps a consumer-side regression guard on the
# behavior the resource relies on.) sandhi_server_route_match resets the param
# count each call, so one stack buffer is reused across cases.
fn test_route_match(): i64 {
    var params[264];

    # exact (no params) still matches
    if (sandhi_server_route_match("/api/notes", "/api/notes", &params) != 1) { return 1; }
    if (sandhi_server_route_match("/", "/", &params) != 1) { return 2; }

    # single `:id` capture
    if (sandhi_server_route_match("/api/notes/5", "/api/notes/:id", &params) != 1) { return 3; }
    if (sandhi_route_param_count(&params) != 1) { return 4; }
    if (sandhi_route_param_int(&params, 0) != 5) { return 5; }

    # segment-count rules: pattern longer / shorter than path
    if (sandhi_server_route_match("/api/notes", "/api/notes/:id", &params) != 0) { return 6; }
    if (sandhi_server_route_match("/api/notes/5", "/api/notes", &params) != 0) { return 7; }

    # empty trailing segment must NOT satisfy a `:id`
    if (sandhi_server_route_match("/api/notes/", "/api/notes/:id", &params) != 0) { return 8; }

    # literal-segment mismatch
    if (sandhi_server_route_match("/api/x/5", "/api/notes/:id", &params) != 0) { return 9; }

    # multiple captures, in order
    if (sandhi_server_route_match("/a/b", "/:x/:y", &params) != 1) { return 10; }
    if (sandhi_route_param_count(&params) != 2) { return 11; }
    if (param_eq(&params, 0, "a") == 0) { return 12; }
    if (param_eq(&params, 1, "b") == 0) { return 13; }

    # non-numeric param: matches the route but param_int rejects it (-> -1)
    if (sandhi_server_route_match("/api/notes/abc", "/api/notes/:id", &params) != 1) { return 14; }
    if (sandhi_route_param_int(&params, 0) != 0 - 1) { return 15; }

    return 0;
}

# Returns 0 on pass, non-zero (case code) on failure. Consumer-side integration
# guard on libro (the sy-core `audit` module's Cyrius target): appends build a
# chain that self-verifies, and the head hash advances with each entry — i.e. the
# entries are hash-LINKED, not independent (the property that makes past-entry
# tampering detectable). libro tests the tamper case itself; this guards that the
# probe's use of chain_new/append/verify/head_hash holds together.
fn test_audit_chain(): i64 {
    var c = chain_new();
    if (c == 0) { return 1; }
    if (chain_verify(c) != 0) { return 2; }          # empty chain: vacuously valid
    if (chain_len(c) != 0) { return 3; }

    chain_append(c, SEV_INFO, str_from("notes"), str_from("create"), str_from("1"));
    if (chain_len(c) != 1) { return 4; }
    if (chain_verify(c) != 0) { return 5; }
    var h1 = chain_head_hash(c);
    if (h1 == 0) { return 6; }

    chain_append(c, SEV_WARNING, str_from("notes"), str_from("delete"), str_from("1"));
    if (chain_len(c) != 2) { return 7; }
    if (chain_verify(c) != 0) { return 8; }
    var h2 = chain_head_hash(c);
    if (h2 == 0) { return 9; }

    # Entries are linked, not independent: the head advances (h1 != h2).
    # constant_time_eq_str returns 1 when equal, 0 when different.
    if (constant_time_eq_str(h1, h2) != 0) { return 10; }

    return 0;
}

# Returns 0 on pass, non-zero (case code) on failure. Consumer-side integration
# guard on ai-hwaccel (the sy-core `hwprobe` module's Cyrius target): read-only
# detection with no subprocess exec produces a non-empty summary JSON string.
# Doesn't assert specific hardware (portable) — just that the detect→serialize
# path the /api/hwinfo endpoint depends on works.
fn test_hwprobe(): i64 {
    hwlog_init();
    var j = registry_to_summary_json(registry_detect_no_exec());
    if (j == 0) { return 1; }
    if (str_len(j) < 2) { return 2; }   # at minimum a "{}" object
    return 0;
}

# Returns 0 on pass, non-zero (case code) on failure. Consumer-side integration
# guard on sigil (the sy-core `crypto` module's Cyrius target, server-side beyond
# TLS): the server Ed25519 keypair signs and verifies, a tampered message is
# rejected, and SHA-256 matches the RFC 6234 known-answer for "abc" (independent of
# the impl — not a round-trip). This is the primitive layer the audit head_sig +
# /api/pubkey rely on.
fn test_crypto(): i64 {
    fl_init();
    if (crypto_init() == 0) { return 1; }
    if (str_len(crypto_pubkey_hex()) != 64) { return 2; }   # 32-byte pubkey → 64 hex
    var sig = alloc(64);
    ed25519_sign(g_crypto_sk, "audit-head", 10, sig);
    if (crypto_verify("audit-head", 10, sig) != 1) { return 3; }   # valid sig verifies
    if (crypto_verify("audit-heaD", 10, sig) != 0) { return 4; }   # tamper rejected
    # SHA-256("abc") = ba7816bf... (RFC 6234 / NIST vector) — independent correctness.
    if (_cstr_eq(sha256_hex("abc", 3),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") == 0) {
        return 5;
    }
    return 0;
}

# Returns 0 on pass, non-zero (case code) on failure. Consumer-side guard on the
# `auth` module (src/auth.cyr): an issued HS256 JWT verifies and yields its subject,
# a tampered token is rejected, and an expired token is rejected. The token is
# issued with sigil HMAC-SHA256; verification recomputes + constant-time compares
# and enforces exp.
fn test_auth(): i64 {
    auth_init();
    var tok = auth_issue("admin", "admin", 3600);
    var tl = str_len(tok);
    var c = alloc(tl + 1);
    memcpy(c, str_data(tok), tl);
    store8(c + tl, 0);
    var sub = auth_verify_sub(c);
    if (sub == 0) { return 1; }                                # valid token rejected
    if (str_len(sub) != 5) { return 2; }
    if (memeq(str_data(sub), "admin", 5) == 0) { return 3; }   # wrong subject
    # The role claim round-trips (RBAC).
    var vc = auth_verify_claims(c);
    if (vc == 0) { return 6; }
    var rl = json_v_str(json_v_obj_get(vc, "role"));
    if (_role_is(rl, "admin") == 0) { return 7; }              # role claim wrong/missing
    # Tamper the last byte (a signature char) → must be rejected.
    store8(c + tl - 1, load8(c + tl - 1) ^ 1);
    if (auth_verify_sub(c) != 0) { return 4; }                 # tampered token accepted
    # Expired (exp in the past) → must be rejected.
    var et = auth_issue("admin", "admin", 0 - 100);
    var el = str_len(et);
    var ec = alloc(el + 1);
    memcpy(ec, str_data(et), el);
    store8(ec + el, 0);
    if (auth_verify_sub(ec) != 0) { return 5; }                # expired token accepted
    return 0;
}

# Returns 0 on pass, non-zero (case code) on failure. Guard on the credential path:
# passwords are verified by re-deriving **Argon2id** (sigil 3.12.0, at sy-core's
# m=19456/t=2/p=1) and constant-time comparing the tag — never a plaintext compare.
# The cross-salt case is the one that proves the salt actually binds: the admin password
# must NOT verify against the user's salt+tag.
fn test_auth_creds(): i64 {
    auth_init();   # decodes the stored salts/tags
    if (_auth_pw_ok(str_lit("changeme"), g_admin_salt, g_admin_hash) != 1) { return 1; }
    if (_auth_pw_ok(str_lit("user1234"), g_user_salt, g_user_hash) != 1) { return 2; }
    if (_auth_pw_ok(str_lit("wrong"), g_admin_salt, g_admin_hash) != 0) { return 3; }
    # one byte off → must fail (no prefix/partial acceptance)
    if (_auth_pw_ok(str_lit("changemf"), g_admin_salt, g_admin_hash) != 0) { return 4; }
    # empty password → must fail
    if (_auth_pw_ok(str_lit(""), g_admin_salt, g_admin_hash) != 0) { return 5; }
    # right password, WRONG salt → must fail (the salt is bound into the tag)
    if (_auth_pw_ok(str_lit("changeme"), g_user_salt, g_admin_hash) != 0) { return 6; }
    return 0;
}

# Returns 0 on pass, non-zero (case code) on failure. Guard on the at-rest key I/O
# (crypto_key_save/load) behind the persistent HMAC secret + Ed25519 seed: a 32-byte
# blob round-trips through a file, and a missing file loads as absent. Temp path.
# Returns 0 on pass, non-zero (case code) on failure. Guard on the `tee` module
# (src/tee.cyr): AES-256-GCM seal→unseal round-trips, and a tampered ciphertext or tag
# is rejected (sigil's GCM auth tag, checked via aes_gcm_decrypt's SIGIL_ERR_NONE=0
# success convention — see FINDINGS).
fn test_tee(): i64 {
    tee_init();
    var src = alloc(32);
    var i = 0; while (i < 32) { store8(src + i, i * 5 + 3); i = i + 1; }
    var b = tee_seal(src, 32);                       # 32 + 28 = 60 bytes
    var pt = tee_unseal(b, 60);
    if (pt == 0) { return 1; }                        # round-trip failed
    if (memeq(pt, src, 32) == 0) { return 2; }        # wrong plaintext
    store8(b + 20, load8(b + 20) ^ 1);                # tamper a ciphertext byte
    if (tee_unseal(b, 60) != 0) { return 3; }         # tamper not rejected
    var b2 = tee_seal(src, 32);
    store8(b2 + 50, load8(b2 + 50) ^ 1);              # tamper a tag byte
    if (tee_unseal(b2, 60) != 0) { return 4; }
    return 0;
}

fn test_keys(): i64 {
    tee_init();
    var src = alloc(32);
    random_bytes(src, 32);
    if (crypto_key_save("/tmp/_yeo_keytest.key", src, 32) == 0) { return 1; }
    var dst = alloc(32);
    if (crypto_key_load("/tmp/_yeo_keytest.key", dst, 32) == 0) { return 2; }
    if (memeq(src, dst, 32) == 0) { return 3; }                       # round-trip mismatch
    if (crypto_key_load("/tmp/_yeo_absent_ffff.key", dst, 32) != 0) { return 4; }  # missing → 0
    return 0;
}

fn main() {
    alloc_init();
    tee_init();   # crypto_init/auth_init seal/unseal via tee — derive the KEK first

    var rm = test_route_match();
    if (rm != 0) {
        print("FAIL: httpd route_match (code ", 31);
        fmt_int(rm);
        println(")");
        return 1;
    }
    println("ok: sandhi route_match path params + segment rules");

    var r = test_bind_text_verbatim_and_safe();
    if (r != 0) {
        print("FAIL: patra bind-text verbatim/safe (code ", 43);
        fmt_int(r);
        println(")");
        return 1;
    }

    println("ok: patra bound text stores verbatim and is injection-safe");

    var a = test_audit_chain();
    if (a != 0) {
        print("FAIL: libro audit chain (code ", 30);
        fmt_int(a);
        println(")");
        return 1;
    }
    println("ok: libro audit chain links, verifies, and advances its head");

    var hw = test_hwprobe();
    if (hw != 0) {
        print("FAIL: ai-hwaccel hwprobe detect/summarize (code ", 47);
        fmt_int(hw);
        println(")");
        return 1;
    }
    println("ok: ai-hwaccel detects and summarizes hardware to JSON");

    var cr = test_crypto();
    if (cr != 0) {
        print("FAIL: sigil crypto (Ed25519 sign/verify + SHA-256) (code ", 52);
        fmt_int(cr);
        println(")");
        return 1;
    }
    println("ok: sigil Ed25519 sign/verify + SHA-256 known-answer");

    var au = test_auth();
    if (au != 0) {
        print("FAIL: auth JWT (issue/verify/tamper/expiry) (code ", 49);
        fmt_int(au);
        println(")");
        return 1;
    }
    println("ok: auth HS256 JWT issue/verify + tamper & expiry rejected");

    var ac = test_auth_creds();
    if (ac != 0) {
        print("FAIL: auth argon2id credential verify (code ", 45);
        fmt_int(ac);
        println(")");
        return 1;
    }
    println("ok: auth credentials verify via argon2id (salt-bound, no plaintext)");

    var te = test_tee();
    if (te != 0) {
        print("FAIL: tee AES-256-GCM seal/unseal (code ", 42);
        fmt_int(te);
        println(")");
        return 1;
    }
    println("ok: tee AES-256-GCM seal/unseal + tamper rejected");

    var ky = test_keys();
    if (ky != 0) {
        print("FAIL: key persistence save/load (code ", 40);
        fmt_int(ky);
        println(")");
        return 1;
    }
    println("ok: key persistence save/load round-trips at rest");
    return 0;
}

var rc = main();
syscall(SYS_EXIT, rc);
