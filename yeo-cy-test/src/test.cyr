# yeo-cy-test — top-level test entry (referenced by cyrius.cyml [build].test).
#
# Two invariants the app relies on:
#   1. patra bound-text storage (1.11.2): a note body in a TEXT column written
#      through a bound `?` param stores/reads byte-for-byte and never reparses
#      as SQL (injection-safe).
#   2. httpd route_match: `:name` path-param matching — segment-count rules,
#      capture, and numeric parsing — the routing the /api/notes/:id resource
#      depends on.

include "src/httpd.cyr"

# Returns 0 on pass, non-zero on failure.
fn test_bind_text_verbatim_and_safe(): i64 {
    fl_init();
    patra_init();

    var db = patra_open("yeo-test.patra");
    if (db == 0) { return 1; }

    # Fresh table each run (ignore DROP error on first run).
    patra_exec(db, "DROP TABLE t");
    if (patra_exec(db, "CREATE TABLE t (id INT, body TEXT)") != PATRA_OK) { return 2; }

    # A body that would inject or truncate if inlined as a SQL literal, plus
    # unicode and a length past the old 256-byte STR cap.
    var s = "O'Brien'; DROP TABLE t-- café ☕ \"quoted\"";
    var slen = strlen(s);

    var stmt = patra_prepare(db, "INSERT INTO t VALUES (?, ?)");
    if (stmt == 0) { return 3; }
    patra_bind_int(stmt, 0, 1);
    patra_bind_text(stmt, 1, s, slen);
    if (patra_exec_prepared(db, stmt) != PATRA_OK) { patra_finalize(stmt); return 4; }
    patra_finalize(stmt);

    # Table must still exist with exactly one row (the `DROP TABLE t--` in the
    # body was stored as data, not executed).
    var rs = patra_query(db, "SELECT id, body FROM t");
    if (rs == 0) { return 5; }
    if (patra_result_count(rs) != 1) { patra_result_free(rs); return 6; }

    # Body round-trips byte-for-byte.
    var blen = patra_result_get_text_len(rs, 0, 1);
    if (blen != slen) { patra_result_free(rs); return 7; }
    var buf = alloc(blen + 1);
    patra_result_read_text(db, rs, 0, 1, buf);
    if (memeq(buf, s, slen) == 0) { patra_result_free(rs); return 8; }
    patra_result_free(rs);

    return 0;
}

# Build a minimal Req carrying just a path cstr (route_match reads REQ_PATH).
fn mk_req(path): i64 {
    var req = req_new();
    store64(req + REQ_PATH, path);
    store64(req + REQ_NPARAMS, 0);
    return req;
}

# A captured param equals the given cstring?
fn param_eq(req, idx, expect): i64 {
    var s = req_param(req, idx);
    var elen = strlen(expect);
    if (str_len(s) != elen) { return 0; }
    return memeq(str_data(s), expect, elen);
}

# Returns 0 on pass, non-zero (case code) on failure.
fn test_route_match(): i64 {
    # exact (no params) still matches
    if (route_match(mk_req("/api/notes"), "/api/notes") != 1) { return 1; }
    if (route_match(mk_req("/"), "/") != 1) { return 2; }

    # single `:id` capture
    var r = mk_req("/api/notes/5");
    if (route_match(r, "/api/notes/:id") != 1) { return 3; }
    if (req_nparams(r) != 1) { return 4; }
    if (req_param_int(r, 0) != 5) { return 5; }

    # segment-count rules: pattern longer / shorter than path
    if (route_match(mk_req("/api/notes"), "/api/notes/:id") != 0) { return 6; }
    if (route_match(mk_req("/api/notes/5"), "/api/notes") != 0) { return 7; }

    # empty trailing segment must NOT satisfy a `:id`
    if (route_match(mk_req("/api/notes/"), "/api/notes/:id") != 0) { return 8; }

    # literal-segment mismatch
    if (route_match(mk_req("/api/x/5"), "/api/notes/:id") != 0) { return 9; }

    # multiple captures, in order
    var r2 = mk_req("/a/b");
    if (route_match(r2, "/:x/:y") != 1) { return 10; }
    if (req_nparams(r2) != 2) { return 11; }
    if (param_eq(r2, 0, "a") == 0) { return 12; }
    if (param_eq(r2, 1, "b") == 0) { return 13; }

    # non-numeric param: matches the route but req_param_int rejects it (-> -1)
    var r3 = mk_req("/api/notes/abc");
    if (route_match(r3, "/api/notes/:id") != 1) { return 14; }
    if (req_param_int(r3, 0) != 0 - 1) { return 15; }

    return 0;
}

fn main() {
    alloc_init();

    var rm = test_route_match();
    if (rm != 0) {
        print("FAIL: httpd route_match (code ", 31);
        fmt_int(rm);
        println(")");
        return 1;
    }
    println("ok: httpd route_match path params + segment rules");

    var r = test_bind_text_verbatim_and_safe();
    if (r != 0) {
        print("FAIL: patra bind-text verbatim/safe (code ", 43);
        fmt_int(r);
        println(")");
        return 1;
    }

    println("ok: patra bound text stores verbatim and is injection-safe");
    return 0;
}

var rc = main();
syscall(SYS_EXIT, rc);
