# httpd.cyr — JSON/file response helpers + body accessors over sandhi's server.
#
# Backstory (the TLS bite's payload, now resolved): serving HTTPS once meant
# bypassing sandhi entirely — sandhi's whole server SEND path was welded to
# plaintext (send_response / router_handler / run_pooled all sock_send a raw fd),
# with no cert/key hook and no Conn seam. So the probe hand-rolled a `Conn`
# transport seam, a TLS accept loop (tls_serve / tls_recv_request), an ALPN
# wire, a SIGPIPE guard, and its own route table over sandhi's matcher.
#
# As of sandhi 1.6.10 (folded into cyrius 6.3.0) the server side is fully Conn-
# aware with TLS: sandhi_server_run_pooled_tls is the pooled HTTPS mirror of
# run_pooled; sandhi_server_router_handler_c routes over a SandhiConn (both
# transports); sandhi_server_options_tls(cert_der, key_pem) configures TLS;
# server-side ALPN (http/1.1) negotiates (cyrius 6.2.22). These are the probe's
# own filed findings, now SHIPPED — so the entire hand-rolled stack above is
# RETIRED and this file is just response convenience over sandhi's conn-aware
# send + body accessors. See FINDINGS.
#
# Route handlers: fn(app_ctx, conn, req_buf, req_len, params): i64
#   write via resp_*(conn, ...) [sandhi's Conn seam → HTTP + HTTPS], body via
#   http_body_*, path params via sandhi_route_param_int. ONE handler set serves
#   plaintext (run_pooled + router_handler_cp) and TLS (run_pooled_tls +
#   router_handler_c).

# cstring literal -> borrowed Str (json_v_* want Str).
fn str_lit(c): Str { return str_new(c, strlen(c)); }

# ── Response framing over sandhi's Conn seam ──
# The probe's handlers carry a status as a "CODE Msg" cstr (e.g. "200 OK");
# sandhi_server_send_response_c wants the numeric code + message ptr separately,
# so split here. (Keeps every handler's resp_*(conn, "200 OK", …) call site.)
fn _status_code(status): i64 {
    var i = 0;
    var n = 0;
    while (load8(status + i) >= 48 && load8(status + i) <= 57) {
        n = n * 10 + (load8(status + i) - 48);
        i = i + 1;
    }
    return n;
}
fn _status_msg(status): i64 {
    var i = 0;
    while (load8(status + i) != 0 && load8(status + i) != 32) { i = i + 1; }
    if (load8(status + i) == 32) { i = i + 1; }
    return status + i;
}

# Frame status line + headers + body and write over the conn. sandhi owns the
# framing (Content-Type/Length, Connection: close) and the transport seam
# (plaintext sock_send vs chunked tls_write); the CORS header rides extra_headers.
fn resp_bytes(conn, status, ctype, body_ptr, body_len): i64 {
    return sandhi_server_send_response_c(conn, _status_code(status), _status_msg(status),
    ctype, body_ptr, body_len, "Access-Control-Allow-Origin: *\r\n");
}

# Send a Str body with the given status + content type.
fn resp_raw(conn, status, ctype, body): i64 {
    return resp_bytes(conn, status, ctype, str_data(body), str_len(body));
}

# Send a built json value (json_v_*) with the given status.
fn resp_json(conn, status, jv): i64 {
    return resp_raw(conn, status, "application/json", json_v_build(jv));
}

fn resp_json_err(conn, status, msg): i64 {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("error"), json_v_str_new(str_lit(msg)));
    return resp_json(conn, status, o);
}

# Read a static file (relative to CWD) and send it, or 404 if absent.
fn resp_file(conn, path, ctype): i64 {
    var buf = alloc(262144);
    var n = file_read_all(path, buf, 262144);
    if (n <= 0) { return resp_json_err(conn, "404 Not Found", "file not found"); }
    return resp_bytes(conn, "200 OK", ctype, buf, n);
}

# ── Request body accessors (over sandhi; bytes after "\r\n\r\n") ──
fn http_body_ptr(buf, blen): i64 {
    var bo = sandhi_server_body_offset(buf, blen);
    if (bo < 0) { return 0; }
    return buf + bo;
}
fn http_body_len(buf, blen): i64 {
    var bo = sandhi_server_body_offset(buf, blen);
    if (bo < 0) { return 0; }
    return blen - bo;
}
