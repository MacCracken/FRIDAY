# httpd.cyr — response framing + request-body accessors over sandhi.
#
# This file used to hand-roll an entire HTTP/1.1 server (request parse, route
# table, response framing, accept loop, worker pool, SIGPIPE guard) under the
# (wrong) FINDINGS verdict "no HTTP server abstraction." That verdict was a
# layer mistake: the services lib `sandhi` provides all of it. Over bites 3–4
# the probe moved fully onto sandhi:
#
#   • wire I/O + smuggling rejects → sandhi_server_* (recv_request, get_method/
#     path, body_offset, send_response/status, has_cl_te_conflict / dup-header).
#   • route table → sandhi 1.6.7 sandhi_router_* + sandhi_server_router_handler
#     (`:name` capture, method dispatch, 404/405). [filed by this probe]
#   • parallel serving → sandhi 1.6.7 sandhi_server_run_pooled (fixed worker-
#     thread pool, SO_RCVTIMEO slowloris guard, SIGPIPE SIG_IGN installed itself).
#     [filed by this probe] — so the probe's accept loop, worker pool, and
#     httpd_ignore_sigpipe shim are all retired.
#
# What remains here is the only consumer-side glue sandhi doesn't dictate: a
# "CODE Msg"-string response convenience over sandhi_server_send_response, JSON
# response helpers (json_v_* → wire), a static-file responder, and body-pointer
# accessors. Route handlers use sandhi's signature
#   fn handler(app_ctx, cfd, req_buf, req_len, params) -> i64
# reading the body via http_body_* and path params via sandhi_route_param_int.

# cstring literal -> borrowed Str (json_v_* / str_builder_add want Str).
fn str_lit(c): Str { return str_new(c, strlen(c)); }

# ── Request body (bytes after the "\r\n\r\n" terminator; sandhi finds offset) ──
fn http_body_ptr(buf, blen): i64 {
    var bo = sandhi_server_body_offset(buf, blen);
    if (bo < 0) { return 0; }
    return buf + bo;
}
fn http_body_len(buf, blen): i64 {
    var bo = sandhi_server_body_offset(buf, blen);
    if (bo < 0) { return 0; }
    return blen - bo;
}

# ── Responses (framed by sandhi_server_send_*) ──
# Status stays a "CODE Msg" cstr (e.g. "200 OK") so handlers read naturally; we
# split it into sandhi's (code:int, msg:cstr).
fn _status_code(status): i64 {
    var i = 0;
    var n = 0;
    while (load8(status + i) >= 48 && load8(status + i) <= 57) {
        n = n * 10 + (load8(status + i) - 48);
        i = i + 1;
    }
    return n;
}
fn _status_msg(status): i64 {
    var i = 0;
    while (load8(status + i) != 0 && load8(status + i) != 32) { i = i + 1; }
    if (load8(status + i) == 32) { i = i + 1; }
    return status + i;
}

# Frame and send one response via sandhi. status/ctype are cstrs; body is Str.
fn resp_raw(cfd, status, ctype, body): i64 {
    return sandhi_server_send_response(cfd, _status_code(status), _status_msg(status),
        ctype, str_data(body), str_len(body), "Access-Control-Allow-Origin: *\r\n");
}

# Send a built json value (json_v_*) with the given status.
fn resp_json(cfd, status, jv): i64 {
    return resp_raw(cfd, status, "application/json", json_v_build(jv));
}

fn resp_json_err(cfd, status, msg): i64 {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("error"), json_v_str_new(str_lit(msg)));
    return resp_json(cfd, status, o);
}

# Read a static file (relative to CWD) and send it, or 404 if absent.
fn resp_file(cfd, path, ctype): i64 {
    var buf = alloc(262144);
    var n = file_read_all(path, buf, 262144);
    if (n <= 0) { return resp_json_err(cfd, "404 Not Found", "file not found"); }
    return sandhi_server_send_response(cfd, 200, "OK", ctype, buf, n,
        "Access-Control-Allow-Origin: *\r\n");
}
