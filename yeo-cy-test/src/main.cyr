# yeo-cy-test — full-stack slice backend.
#
# This file owns the route handlers + the patra persistence for /api/notes. The
# HTTP layer is entirely sandhi (1.6.7): routes are registered on sandhi's router
# (sandhi_router_*) and served by sandhi_server_run_pooled (a fixed worker-thread
# pool); src/httpd.cyr is just response-framing + body-accessor glue over sandhi.
# Handlers use sandhi's route-handler signature
#   fn(app_ctx, cfd, req_buf, req_len, params): i64
# reading the body via http_body_* and path params via sandhi_route_param_int.
#
# Persistence (patra 1.11.4): note bodies are a TEXT column written through a
# prepared statement with a bound `?` parameter (patra_bind_text) — stored as
# bytes, never reparsed as SQL (injection-safe), no length cap. Ids are patra
# AUTOINCREMENT (schema `id INT AUTOINCREMENT`, column-list INSERT, echoed via
# patra_last_insert_id); PUT/DELETE return a real 404 via patra_rows_affected.
#
# Concurrency: patra is internally thread-safe (P1, v1.11.0 — a process-global
# mutex serializes statement ops; result sets are caller-owned), so the pooled
# workers call patra directly with no external lock. CAVEAT: last_insert_id /
# rows_affected read shared-handle fields, so the write + readback are not atomic
# across concurrent workers (latent race — see FINDINGS).
#
# Stdlib + deps (patra, sakshi) auto-included via cyrius.cyml.

include "src/httpd.cyr"

var PORT = 8080;
var g_db = 0;

# ── database ──

fn db_init(): i64 {
    fl_init();
    patra_init();
    g_db = patra_open("yeo.patra");
    if (g_db == 0) { return 0; }
    # id is AUTOINCREMENT (patra 1.10.1): patra assigns the next id on an INSERT
    # that omits it, so the app no longer tracks/seeds g_next_id. NB patra
    # AUTOINCREMENT is derive-from-MAX, so an id can be REUSED after the highest
    # row is deleted (not strict-monotonic) — see FINDINGS.
    patra_exec(g_db, "CREATE TABLE notes (id INT AUTOINCREMENT, body TEXT, created INT)");
    return 1;
}

# ── route handlers (sandhi router signature: fn(app_ctx, cfd, req_buf, req_len,
# params): i64 — body via http_body_*, path params via sandhi_route_param_int) ──

fn handle_index(ctx, cfd, buf, blen, params): i64 {
    return resp_file(cfd, "web/index.html", "text/html; charset=utf-8");
}

fn handle_appjs(ctx, cfd, buf, blen, params): i64 {
    return resp_file(cfd, "web/app.js", "text/javascript; charset=utf-8");
}

fn handle_health(ctx, cfd, buf, blen, params): i64 {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("status"),  json_v_str_new(str_lit("ok")));
    json_v_obj_set(o, str_lit("service"), json_v_str_new(str_lit("yeo-cy-test")));
    json_v_obj_set(o, str_lit("version"), json_v_str_new(str_lit("0.1.0")));
    return resp_json(cfd, "200 OK", o);
}

fn handle_list_notes(ctx, cfd, buf, blen, params): i64 {
    # patra_query is internally serialized and returns a caller-owned result
    # set, so no external lock is needed across the read + JSON build.
    var rs = patra_query(g_db, "SELECT id, body, created FROM notes ORDER BY id");
    var arr = json_v_arr_new();
    if (rs != 0) {
        var c = patra_result_count(rs);
        var i = 0;
        while (i < c) {
            json_v_arr_push(arr, note_row_json(rs, i));
            i = i + 1;
        }
        patra_result_free(rs);
    }
    return resp_json(cfd, "200 OK", arr);
}

fn handle_create_note(ctx, cfd, buf, blen, params): i64 {
    var bptr = http_body_ptr(buf, blen);
    var bln = http_body_len(buf, blen);
    if (bptr == 0 || bln <= 0) { return resp_json_err(cfd, "400 Bad Request", "missing request body"); }

    var v = json_v_parse_str(bptr, bln);
    if (v == 0) { return resp_json_err(cfd, "400 Bad Request", "invalid JSON"); }

    var bstr = json_v_str(json_v_obj_get(v, "body"));
    if (bstr == 0) { return resp_json_err(cfd, "400 Bad Request", "missing string field 'body'"); }

    var ts = clock_epoch_secs();

    # Column-list INSERT (patra 1.11) omitting the AUTOINCREMENT id, so patra
    # assigns it. The body is bound as text (stored as bytes, never reparsed as
    # SQL → metacharacters are safe). patra serializes the INSERT internally
    # (v1.11.0+), so the write itself needs no external lock.
    var stmt = patra_prepare(g_db, "INSERT INTO notes (body, created) VALUES (?, ?)");
    if (stmt == 0) { return resp_json_err(cfd, "500 Internal Server Error", "prepare failed"); }
    patra_bind_text(stmt, 0, str_data(bstr), str_len(bstr));
    patra_bind_int(stmt, 1, ts);
    var rc = patra_exec_prepared(g_db, stmt);
    # patra_last_insert_id (1.11.3) reads back the auto-assigned id for the 201
    # echo, read as tight as possible after the INSERT. CAVEAT: DB_LAST_ID is a
    # shared-handle field and the INSERT + readback are two separate ops with no
    # app lock between them, so a concurrent INSERT on g_db can overwrite it
    # before this read — the echoed id may then be another worker's. The stored
    # rows are still uniquely id'd (patra assigns under its mutex); only the echo
    # races. See FINDINGS scenario "last_insert_id concurrency".
    var id = patra_last_insert_id(g_db);
    patra_finalize(stmt);
    if (rc != PATRA_OK) {
        return resp_json_err(cfd, "500 Internal Server Error", "insert failed");
    }

    # Echo the created note back (with the original body).
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("id"),      json_v_int_new(id));
    json_v_obj_set(o, str_lit("body"),    json_v_str_new(bstr));
    json_v_obj_set(o, str_lit("created"), json_v_int_new(ts));
    return resp_json(cfd, "201 Created", o);
}

# Build a note JSON object from result-set row `row` of `rs` (cols: id, body,
# created). The body is a TEXT column read by length. Shared by the single-note
# read path.
fn note_row_json(rs, row): i64 {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("id"), json_v_int_new(patra_result_get_int(rs, row, 0)));
    var blen = patra_result_get_text_len(rs, row, 1);
    if (blen < 0) { blen = 0; }
    var bbuf = alloc(blen + 1);
    patra_result_read_text(g_db, rs, row, 1, bbuf);
    json_v_obj_set(o, str_lit("body"), json_v_str_new(str_new(bbuf, blen)));
    json_v_obj_set(o, str_lit("created"), json_v_int_new(patra_result_get_int(rs, row, 2)));
    return o;
}

# GET /api/notes/:id — fetch one note by id. Bound WHERE param (the id is an INT
# column, so the patra "WHERE on TEXT never matches" constraint doesn't apply).
fn handle_get_note(ctx, cfd, buf, blen, params): i64 {
    var id = sandhi_route_param_int(params, 0);
    if (id < 0) { return resp_json_err(cfd, "400 Bad Request", "invalid id"); }
    var stmt = patra_prepare(g_db, "SELECT id, body, created FROM notes WHERE id = ?");
    if (stmt == 0) { return resp_json_err(cfd, "500 Internal Server Error", "prepare failed"); }
    patra_bind_int(stmt, 0, id);
    var rs = patra_query_prepared(g_db, stmt);
    patra_finalize(stmt);
    if (rs == 0) { return resp_json_err(cfd, "500 Internal Server Error", "query failed"); }
    if (patra_result_count(rs) <= 0) {
        patra_result_free(rs);
        return resp_json_err(cfd, "404 Not Found", "note not found");
    }
    var o = note_row_json(rs, 0);
    patra_result_free(rs);
    return resp_json(cfd, "200 OK", o);
}

# PUT /api/notes/:id — replace a note's body. {"body": "..."} in the request
# body; the new body is a bound text param, the id a bound WHERE param.
fn handle_update_note(ctx, cfd, buf, blen, params): i64 {
    var id = sandhi_route_param_int(params, 0);
    if (id < 0) { return resp_json_err(cfd, "400 Bad Request", "invalid id"); }
    var bptr = http_body_ptr(buf, blen);
    var bln = http_body_len(buf, blen);
    if (bptr == 0 || bln <= 0) { return resp_json_err(cfd, "400 Bad Request", "missing request body"); }
    var v = json_v_parse_str(bptr, bln);
    if (v == 0) { return resp_json_err(cfd, "400 Bad Request", "invalid JSON"); }
    var bstr = json_v_str(json_v_obj_get(v, "body"));
    if (bstr == 0) { return resp_json_err(cfd, "400 Bad Request", "missing string field 'body'"); }

    # `?` placeholders bind in occurrence order: SET body=? is slot 0, WHERE id=?
    # is slot 1.
    var stmt = patra_prepare(g_db, "UPDATE notes SET body = ? WHERE id = ?");
    if (stmt == 0) { return resp_json_err(cfd, "500 Internal Server Error", "prepare failed"); }
    patra_bind_text(stmt, 0, str_data(bstr), str_len(bstr));
    patra_bind_int(stmt, 1, id);
    var rc = patra_exec_prepared(g_db, stmt);
    patra_finalize(stmt);
    if (rc != PATRA_OK) { return resp_json_err(cfd, "500 Internal Server Error", "update failed"); }

    # patra_rows_affected (1.11.3, the filed readback gap): the WHERE matched 0
    # rows → the id doesn't exist → 404. This replaces the old pre-SELECT
    # existence round-trip (one statement instead of two). Caveat: rows_affected
    # reads a shared-handle field (DB_ROWS_AFFECTED), so the UPDATE + read are
    # only atomic if no other write interleaves on g_db — see FINDINGS.
    if (patra_rows_affected(g_db) <= 0) { return resp_json_err(cfd, "404 Not Found", "note not found"); }

    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("id"),   json_v_int_new(id));
    json_v_obj_set(o, str_lit("body"), json_v_str_new(bstr));
    return resp_json(cfd, "200 OK", o);
}

# DELETE /api/notes/:id — remove a note. With patra_rows_affected (1.11.3) we can
# now distinguish "deleted" from "nothing there" and return a real 404 on a
# missing id, instead of the old forced idempotent-200 (which was a workaround
# for patra having no rows-affected count, not a REST preference). Idempotent-200
# is also valid REST; switched to 404-on-missing here to exercise the new API.
fn handle_delete_note(ctx, cfd, buf, blen, params): i64 {
    var id = sandhi_route_param_int(params, 0);
    if (id < 0) { return resp_json_err(cfd, "400 Bad Request", "invalid id"); }
    var stmt = patra_prepare(g_db, "DELETE FROM notes WHERE id = ?");
    if (stmt == 0) { return resp_json_err(cfd, "500 Internal Server Error", "prepare failed"); }
    patra_bind_int(stmt, 0, id);
    var rc = patra_exec_prepared(g_db, stmt);
    patra_finalize(stmt);
    if (rc != PATRA_OK) { return resp_json_err(cfd, "500 Internal Server Error", "delete failed"); }
    # 0 rows matched → nothing to delete → 404 (shared-handle readback caveat as
    # in PUT — see FINDINGS).
    if (patra_rows_affected(g_db) <= 0) { return resp_json_err(cfd, "404 Not Found", "note not found"); }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("deleted"), json_v_int_new(id));
    return resp_json(cfd, "200 OK", o);
}

# ── entry ──

fn main() {
    alloc_init();

    if (db_init() == 0) { println("error: patra_open failed"); return 1; }

    # sandhi 1.6.7 router (app_ctx=0; handlers read g_db as a global). Routes are
    # matched first-match-wins with :name capture + method dispatch; sandhi emits
    # 404 (no path) / 405 (path but wrong method) itself.
    var router = sandhi_router_new(0);
    sandhi_router_add(router, "GET",    "/",              &handle_index);
    sandhi_router_add(router, "GET",    "/app.js",        &handle_appjs);
    sandhi_router_add(router, "GET",    "/api/health",    &handle_health);
    sandhi_router_add(router, "GET",    "/api/notes",     &handle_list_notes);
    sandhi_router_add(router, "POST",   "/api/notes",     &handle_create_note);
    sandhi_router_add(router, "GET",    "/api/notes/:id", &handle_get_note);
    sandhi_router_add(router, "PUT",    "/api/notes/:id", &handle_update_note);
    sandhi_router_add(router, "DELETE", "/api/notes/:id", &handle_delete_note);

    # sandhi 1.6.7 thread-pool serve (the other feature this probe filed and
    # kept its own pool for). max_conns is the FIXED worker-thread count (4, to
    # match the old hand-rolled pool); idle_ms left at the 30s default — a
    # per-connection SO_RCVTIMEO slowloris guard the hand-rolled pool lacked.
    # run_pooled installs the SIGPIPE SIG_IGN guard itself (Linux), so the
    # probe's httpd_ignore_sigpipe shim is gone.
    var opts = sandhi_server_options_new();
    sandhi_server_options_max_conns(opts, 4);
    println("yeo-cy-test listening on :8080 (sandhi_server_run_pooled, 4 workers)");
    return sandhi_server_run_pooled(INADDR_ANY(), PORT, &sandhi_server_router_handler, router, opts);
}

var r = main();
syscall(SYS_EXIT, r);
