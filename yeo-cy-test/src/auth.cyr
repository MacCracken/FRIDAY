# src/auth.cyr — SecureYeoman `auth` module (first bite: JWT sessions).
#
# The fourth sy-core module grown into the probe, and the defining SecureYeoman
# capability. sy-core's auth is JWT + API keys + RBAC (+ OIDC/PKCE + WebAuthn). This
# first bite is the core token mechanism: a login endpoint that ISSUES a signed
# HS256 JWT, and a bearer-protected route that VERIFIES it.
#
# CYRIUS TARGET / FINDING: the mapping named **bote** (it advertises "JWT HS256 +
# PKCE + bearer"), but bote's JWT surface (src/jwt.cyr) is **verify-only** —
# `jwt_verify_hs256`, no `jwt_create`/encode — because bote is an MCP *resource
# server* that validates incoming bearer tokens, not an issuer/IdP. It also has no
# thin "jwt-only" profile (you'd pull the ~93 KB MCP core for one function). So a
# consumer that needs to ISSUE tokens (a login) builds it from primitives. That's
# fine here: HS256 = HMAC-SHA256, which sigil already provides (this builds directly
# on the crypto module), and base64url + JSON come from bayan. Filed as a bote gap
# in FINDINGS (recommend a thin `bote-jwt` profile with issue + verify).
#
# The issued token is a standard RFC 7519 HS256 JWT, so it verifies under any
# conforming implementation — cross-checked independently against Python's PyJWT/
# HMAC in tests/verify.py (scenario 15), not just against our own verifier.
#
# Statelessness: the HMAC secret is generated once at init and read-only after, so
# issuing/verifying use only per-call buffers — thread-safe, no lock.
#
# CREDENTIALS: Argon2id (RFC 9106) via sigil 3.12.0, at sy-core's exact parameters
# (m=19456, t=2, p=1). This closes the probe's last plaintext-credential gap — and the
# primitive exists because this probe filed the gap: sigil had no password KDF, and the
# only path to Argon2id was escaping to OpenSSL's libcrypto through a soft-deprecated
# `tls_dlsym` hatch, which would have broken sigil's "zero external crypto dependencies"
# contract. sigil 3.12.0 (folded by cyrius 6.4.63) ships it natively instead.
#
# LOGIN ABUSE CONTROL: Argon2id's ~244 ms makes `/api/login` a request-amplification lever
# (measured: 8 concurrent attempts pushed `GET /api/health` 6 ms -> 942 ms; ~40 wedged the
# 4-worker pool). Two layers now bound it: a **per-IP token bucket** (5/min default,
# `SY_LOGIN_BURST` / `SY_LOGIN_REFILL_MS`) that stops one source grinding indefinitely, and
# a **concurrency cap** (2 of 4 workers) that bounds the pool even across many sources.
# Both shed with 429 BEFORE any Argon2 work, so a rejected attempt is ~free. The per-IP half
# only became possible when sandhi **1.9.0** added `sandhi_server_conn_peer_ip` (folded in
# cyrius 6.4.64) — a gap this probe filed.
#
# LIMITATIONS (future bites): PKCE / OIDC / WebAuthn; no lockout/backoff on repeated
# failures for a given SUBJECT (the bucket is keyed by source address only); an unknown
# peer (ip==0, e.g. AGNOS) is NOT rate-limited — it fails open by design, since keying every
# unknown peer to one bucket would let a single client lock out all others (see FINDINGS).

var g_jwt_secret     = 0;          # 32-byte HS256 HMAC secret (ephemeral)
var g_jwt_secret_len = 32;
var g_auth_key_path  = "yeo-auth.key"; # persisted 32-byte HS256 secret (0600, gitignored)

# ── credentials: Argon2id-hashed, never plaintext ──
#
# sy-core's `verify_admin_password` verifies an **Argon2id** PHC hash (Rust `argon2` 0.5,
# `Argon2::default()`), so these use its exact parameters: m=19456 KiB, t=2, p=1, 32-byte
# tag, 16-byte salt. Reachable natively as of **sigil 3.12.0** (folded by cyrius 6.4.63) —
# the probe drove that primitive precisely to close this gap; until it landed, this was a
# length-checked plaintext compare (see FINDINGS).
#
# The demo passwords are NOT in this source. Stored per credential: a salt + the Argon2id
# tag of the password under it. Login re-derives and constant-time compares. (The salts are
# fixed and published rather than random-per-user only because these are throwaway demo
# credentials and fixed salts make the values reproducible test vectors; a real deployment
# generates a random salt per user and stores the PHC string.)
var ARGON2_M = 19456;   # KiB — Argon2::default()
var ARGON2_T = 2;       # passes
var ARGON2_P = 1;       # lanes
var ARGON2_TAG = 32;    # tag bytes
var ARGON2_SALT = 16;   # salt bytes

# admin / "changeme" → role=admin
var g_admin_salt_hex = "a1a1a1a1a1a1a1a1b2b2b2b2b2b2b2b2";
var g_admin_hash_hex = "076ded3c3681c3b7e0bb39087599b6e241dc2b5aaf5b2ee71cdd80d90862ae27";
# user / "user1234" → role=user (exercises RBAC)
var g_user_salt_hex  = "c3c3c3c3c3c3c3c3d4d4d4d4d4d4d4d4";
var g_user_hash_hex  = "4037965ccc61ec820b310a42f5eb0153157abb1e72bf9d714a720f97e1d54f45";

# Decoded at init (hex → bytes), read-only after → thread-safe.
var g_admin_salt = 0;
var g_admin_hash = 0;
var g_user_salt  = 0;
var g_user_hash  = 0;

# Per-thread Argon2 arena. Argon2id at m=19456 needs ~19 MiB of working memory; sigil's
# allocating `argon2id` wrapper would call the non-thread-safe `fl_alloc` on every login,
# and logins run on concurrent sandhi workers. So each worker allocates its arena ONCE
# (first login on that thread) and reuses it via `argon2id_into`, which touches no
# allocator. Slot 13: sigil owns 8, patra 0-4, this probe uses 14 (audit) / 15 (db).
var TLS_A2MEM = 13;

fn _a2_mem(): i64 {
    var m = thread_local_get(TLS_A2MEM);
    if (m == 0) {
        m = fl_alloc(argon2_mem_bytes(ARGON2_M, ARGON2_P));
        thread_local_set(TLS_A2MEM, m);
    }
    return m;
}

# Persistent HMAC secret: load if present, else generate + persist — so JWTs issued
# before a restart still verify after. Reuses crypto_key_load/save (src/crypto.cyr).
fn auth_init(): i64 {
    g_jwt_secret = alloc(32);
    if (crypto_key_load(g_auth_key_path, g_jwt_secret, 32) == 0) {
        random_bytes(g_jwt_secret, 32);
        crypto_key_save(g_auth_key_path, g_jwt_secret, 32);
    }
    # Decode the credential salts/tags once (read-only after → no lock on the login path).
    g_admin_salt = alloc(ARGON2_SALT);
    g_admin_hash = alloc(ARGON2_TAG);
    g_user_salt  = alloc(ARGON2_SALT);
    g_user_hash  = alloc(ARGON2_TAG);
    hex_decode_into(g_admin_salt_hex, strlen(g_admin_salt_hex), g_admin_salt);
    hex_decode_into(g_admin_hash_hex, strlen(g_admin_hash_hex), g_admin_hash);
    hex_decode_into(g_user_salt_hex,  strlen(g_user_salt_hex),  g_user_salt);
    hex_decode_into(g_user_hash_hex,  strlen(g_user_hash_hex),  g_user_hash);
    _rl_init();
    return 1;
}

# ── small helpers ──

# base64url-encode a buffer → Cyrius str (base64url_encode returns a cstr).
fn _b64u(ptr, len): i64 { return str_from(base64url_encode(ptr, len)); }

# Exact decoded byte length of a base64url (no-padding) string of `n` chars.
fn _b64u_declen(n): i64 {
    var full = (n / 4) * 3;
    var rem = n % 4;
    if (rem == 2) { return full + 1; }
    if (rem == 3) { return full + 2; }
    return full;
}

# base64url char → 6-bit value, or -1 if not a base64url char.
fn _b64u_val(c): i64 {
    if ((c >= 65) && (c <= 90))  { return c - 65; }   # A-Z → 0..25
    if ((c >= 97) && (c <= 122)) { return c - 71; }   # a-z → 26..51
    if ((c >= 48) && (c <= 57))  { return c + 4; }    # 0-9 → 52..61
    if (c == 45) { return 62; }                       # '-'
    if (c == 95) { return 63; }                       # '_'
    return 0 - 1;
}

# Decode `elen` base64url (no-padding) chars from `enc` into an owned buffer of
# _b64u_declen(elen) bytes (NUL-terminated). Returns 0 on an invalid char.
# In-probe because bayan's base64url_decode did not round-trip its own encode here
# (returned null on a valid no-pad string — see FINDINGS); bayan's ENCODE is fine.
fn _b64u_decode(enc, elen): i64 {
    var out_len = _b64u_declen(elen);
    var out = alloc(out_len + 1);
    var si = 0;
    var di = 0;
    while (si + 4 <= elen) {
        var a = _b64u_val(load8(enc + si));
        var b = _b64u_val(load8(enc + si + 1));
        var c = _b64u_val(load8(enc + si + 2));
        var d = _b64u_val(load8(enc + si + 3));
        if ((a < 0) || (b < 0) || (c < 0) || (d < 0)) { return 0; }
        store8(out + di,     ((a << 2) | (b >> 4)) & 255);
        store8(out + di + 1, (((b & 15) << 4) | (c >> 2)) & 255);
        store8(out + di + 2, (((c & 3) << 6) | d) & 255);
        si = si + 4;
        di = di + 3;
    }
    var rem = elen - si;
    if (rem == 2) {
        var a2 = _b64u_val(load8(enc + si));
        var b2 = _b64u_val(load8(enc + si + 1));
        if ((a2 < 0) || (b2 < 0)) { return 0; }
        store8(out + di, ((a2 << 2) | (b2 >> 4)) & 255);
    }
    if (rem == 3) {
        var a3 = _b64u_val(load8(enc + si));
        var b3 = _b64u_val(load8(enc + si + 1));
        var c3 = _b64u_val(load8(enc + si + 2));
        if ((a3 < 0) || (b3 < 0) || (c3 < 0)) { return 0; }
        store8(out + di,     ((a3 << 2) | (b3 >> 4)) & 255);
        store8(out + di + 1, (((b3 & 15) << 4) | (c3 >> 2)) & 255);
    }
    store8(out + out_len, 0);
    return out;
}

# Index of byte `ch` in cstr `s` at/after `start`, or -1.
fn _find_byte(s, ch, start): i64 {
    var i = start;
    while (load8(s + i) != 0) {
        if (load8(s + i) == ch) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# cstr `s` starts with cstr `prefix`?
fn _starts_with(s, prefix): i64 {
    var i = 0;
    while (load8(prefix + i) != 0) {
        if (load8(s + i) != load8(prefix + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Constant-time equality of two NUL-terminated cstrs (length compared first — the
# length of a base64url signature is not secret; the bytes are).
fn _ct_cstr_eq(a, b): i64 {
    var la = strlen(a);
    if (la != strlen(b)) { return 0; }
    var diff = 0;
    var i = 0;
    while (i < la) {
        diff = diff | (load8(a + i) ^ load8(b + i));
        i = i + 1;
    }
    return diff == 0;
}

# ── issue / verify ──

# Issue an HS256 JWT for `sub`/`role` (cstrs) valid for `ttl` seconds → token str.
# token = base64url(header) "." base64url(payload) "." base64url(HMAC-SHA256(signing_input)).
fn auth_issue(sub, role, ttl): i64 {
    var now = clock_epoch_secs();
    var hdr = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
    var hb = _b64u(hdr, strlen(hdr));

    var pj = json_v_obj_new();
    json_v_obj_set(pj, str_lit("sub"),  json_v_str_new(str_from(sub)));
    json_v_obj_set(pj, str_lit("role"), json_v_str_new(str_from(role)));
    json_v_obj_set(pj, str_lit("iat"),  json_v_int_new(now));
    json_v_obj_set(pj, str_lit("exp"),  json_v_int_new(now + ttl));
    var pjs = json_v_build(pj);
    var pb = _b64u(str_data(pjs), str_len(pjs));

    # signing input = hb "." pb
    var sib = str_builder_new();
    str_builder_add(sib, hb);
    str_builder_add_cstr(sib, ".");
    str_builder_add(sib, pb);
    var si = str_builder_build(sib);

    var sig = alloc(32);
    hmac_sha256(g_jwt_secret, g_jwt_secret_len, str_data(si), str_len(si), sig);
    var sgb = _b64u(sig, 32);

    var tb = str_builder_new();
    str_builder_add(tb, si);
    str_builder_add_cstr(tb, ".");
    str_builder_add(tb, sgb);
    return str_builder_build(tb);
}

# Verify a bearer token cstr: recompute the HS256 signature and constant-time compare,
# then decode the payload and enforce `exp`. Returns the parsed payload json_v object
# (the claims: sub/role/iat/exp) on success, else 0. Callers read claims from it.
fn auth_verify_claims(token): i64 {
    var d1 = _find_byte(token, 46, 0);        # first '.'
    if (d1 <= 0) { return 0; }
    var d2 = _find_byte(token, 46, d1 + 1);   # second '.'
    if (d2 <= d1 + 1) { return 0; }

    # signing input is token[0, d2) = header "." payload; recompute the HMAC.
    var sig = alloc(32);
    hmac_sha256(g_jwt_secret, g_jwt_secret_len, token, d2, sig);
    if (_ct_cstr_eq(base64url_encode(sig, 32), token + d2 + 1) == 0) { return 0; }

    # Signature OK — decode the payload segment and enforce exp.
    var plen = d2 - d1 - 1;
    var raw = _b64u_decode(token + d1 + 1, plen);
    if (raw == 0) { return 0; }
    var v = json_v_parse_str(raw, _b64u_declen(plen));
    if (v == 0) { return 0; }
    if (json_v_int(json_v_obj_get(v, "exp")) <= clock_epoch_secs()) { return 0; }
    return v;
}

# Convenience: the verified subject str, or 0. (Used by the unit invariant.)
fn auth_verify_sub(token): i64 {
    var v = auth_verify_claims(token);
    if (v == 0) { return 0; }
    return json_v_str(json_v_obj_get(v, "sub"));
}

# Password check: does `pw` (a str) hash to the stored Argon2id tag under `salt`?
# Derives with sy-core's parameters and constant-time compares the 32-byte tag — no
# plaintext, no early-exit on tag bytes. Returns 1 on match, 0 otherwise.
#
# Cost is deliberate: ~244 ms per call on this host (that is what makes offline cracking
# expensive). Memory is NOT per-call — the ~19 MiB arena is per worker thread and reused
# (RSS measured flat at ~80 MB across 5 or 80 logins). The cost that bites is CPU: it makes
# /api/login a request-amplification lever, which `handle_login`'s admission control caps.
fn _auth_pw_ok(pw, salt, expected_tag): i64 {
    var tag = alloc(ARGON2_TAG);
    var rc = argon2id_into(_a2_mem(), str_data(pw), str_len(pw), salt, ARGON2_SALT,
    ARGON2_T, ARGON2_M, ARGON2_P, tag, ARGON2_TAG);
    if (rc != SIGIL_ERR_NONE) { return 0; }
    return ct_eq_bytes_lens(tag, ARGON2_TAG, expected_tag, ARGON2_TAG);
}

# Role claim (str) equals a cstr?
fn _role_is(role, want): i64 {
    if (role == 0) { return 0; }
    var n = strlen(want);
    if (str_len(role) != n) { return 0; }
    return memeq(str_data(role), want, n);
}

# ── handlers ──

# ── login admission control ──
#
# Argon2id is deliberately expensive (~244 ms of CPU per attempt), which makes an
# unauthenticated POST /api/login a request-amplification lever: a few hundred bytes buys
# a quarter-second of a worker. The pool is 4 workers, so 8 concurrent attempts starved
# real traffic — a measured `GET /api/health` went **6 ms → 942 ms**, and ~40 concurrent
# attempts wedged the server outright. Making passwords costly to crack made the endpoint
# cheap to abuse; this is the other half of that trade.
#
# Fix: cap CONCURRENT derivations. At most `LOGIN_MAX_INFLIGHT` logins may be hashing at
# once; excess attempts are shed with 429 **before** any Argon2 work, so a rejected
# attempt costs the server ~nothing (no amplification). With 2 of 4 workers, half the pool
# is always free for real traffic no matter how hard login is hammered.
#
# The concurrency cap alone is not enough: it bounds how much CPU login can hold at once,
# but an attacker can still keep 2 workers saturated forever. Bounding SUSTAINED attempts
# needs to attribute them to a source — which is why this probe filed the sandhi ask.
# **sandhi 1.9.0** (`sandhi_server_conn_peer_ip`, folded in cyrius 6.4.64) delivered it, so
# the second half is now a per-IP token bucket below.
var LOGIN_MAX_INFLIGHT = 2;    # of the 4-worker pool
var g_login_inflight = 0;

# ── per-IP login rate limit (token bucket) ──
#
# 5 attempts per minute per IP, burst 5. Costly-to-crack passwords must not become a
# cheap way to burn the server: the concurrency cap stops a burst from starving the pool,
# and this stops one source from grinding it indefinitely.
#
# Fixed-size table, so the limiter itself can't be turned into a memory-exhaustion vector
# by spraying source addresses (the classic own-goal in naive per-IP maps). On overflow the
# least-recently-seen entry is evicted; a spraying attacker therefore evicts *itself*,
# while a sustained single-source attacker (the case that matters) stays pinned in the
# table and stays limited.
#
# Tokens are scaled by 1000 (milli-tokens) — integer math only, no floats.
#
# FAIL OPEN on an unknown peer: sandhi reports ip==0 when the address is unavailable
# (AGNOS has no BSD getpeername — its contract says 0 means "unknown", never a real peer).
# We do NOT rate-limit an unknown source, because keying every unknown peer to the same
# bucket would let one client lock out all others. Unknown peers still face the
# concurrency cap. That is a deliberate, documented trade — see FINDINGS.
# Burst/refill are env-tunable (`SY_LOGIN_BURST`, `SY_LOGIN_REFILL_MS`) with
# production-safe DEFAULTS. The defaults are what a real deployment wants; the knob exists
# because the test suite drives ~50 logins from a single source (127.0.0.1) and would
# otherwise rate-limit itself — the honest fix is a configurable limit, not a weak default.
# Scenario 21 restarts the server with a deliberately tiny burst to prove the limiter.
var LOGIN_RL_SLOTS     = 64;      # tracked source IPs (fixed — bounded memory)
var LOGIN_RL_BURST     = 5;       # max tokens (SY_LOGIN_BURST)
var LOGIN_RL_REFILL_MS = 12000;   # 1 token per 12s -> 5/min sustained (SY_LOGIN_REFILL_MS)
var LOGIN_RL_ENTRY     = 24;      # ip(8) | milli_tokens(8) | last_ms(8)
var g_rl_table = 0;
var g_rl_lock  = 0;

fn _rl_init(): i64 {
    var b = getenv("SY_LOGIN_BURST");
    if ((b != 0) && (strlen(b) > 0)) {
        var bv = atoi(b);
        if (bv > 0) { LOGIN_RL_BURST = bv; }
    }
    var r = getenv("SY_LOGIN_REFILL_MS");
    if ((r != 0) && (strlen(r) > 0)) {
        var rv = atoi(r);
        if (rv > 0) { LOGIN_RL_REFILL_MS = rv; }
    }
    g_rl_table = alloc(LOGIN_RL_SLOTS * LOGIN_RL_ENTRY);
    memset(g_rl_table, 0, LOGIN_RL_SLOTS * LOGIN_RL_ENTRY);
    g_rl_lock = mutex_new();
    return 0;
}

# Consume one token for `ip`. Returns 1 = allow, 0 = rate-limited.
# Serialized by g_rl_lock: the table is shared across sandhi workers, and the critical
# section is a few microseconds against Argon2id's ~244 ms — contention is irrelevant.
fn _rl_allow(ip): i64 {
    if (ip == 0) { return 1; }              # unknown peer -> fail open (see above)
    mutex_lock(g_rl_lock);
    var now = clock_now_ms();

    # Find this ip, or the least-recently-seen slot to evict, or a free slot.
    var slot = 0 - 1;
    var victim = 0;
    var oldest = now + 1;
    var i = 0;
    while (i < LOGIN_RL_SLOTS) {
        var e = g_rl_table + i * LOGIN_RL_ENTRY;
        var eip = load64(e);
        if (eip == ip) { slot = i; i = LOGIN_RL_SLOTS; }
        else {
            if (eip == 0) {
                if (oldest > 0) { victim = i; oldest = 0; }   # prefer a free slot
            } else {
                var last = load64(e + 16);
                if (last < oldest) { oldest = last; victim = i; }
            }
            i = i + 1;
        }
    }

    var e = 0;
    if (slot < 0) {
        # New source: claim the victim slot with a full bucket.
        e = g_rl_table + victim * LOGIN_RL_ENTRY;
        store64(e, ip);
        store64(e + 8, LOGIN_RL_BURST * 1000);
        store64(e + 16, now);
    } else {
        e = g_rl_table + slot * LOGIN_RL_ENTRY;
        # Refill for elapsed time, capped at the burst ceiling.
        var elapsed = now - load64(e + 16);
        if (elapsed < 0) { elapsed = 0; }        # clock went backwards -> no free tokens
        var toks = load64(e + 8) + (elapsed * 1000) / LOGIN_RL_REFILL_MS;
        if (toks > (LOGIN_RL_BURST * 1000)) { toks = LOGIN_RL_BURST * 1000; }
        store64(e + 8, toks);
        store64(e + 16, now);
    }

    var have = load64(e + 8);
    if (have < 1000) {
        mutex_unlock(g_rl_lock);
        return 0;                               # limited
    }
    store64(e + 8, have - 1000);
    mutex_unlock(g_rl_lock);
    return 1;
}

# POST /api/login {"password":"..."} → {token, token_type, expires_in}, 401, or 429.
# Admission control wraps the real handler so there is exactly one decrement path.
fn handle_login(ctx, conn, buf, blen, params): i64 {
    # 1. Per-IP budget FIRST — cheapest check, and it sheds a sustained attacker before
    #    they can occupy an in-flight slot at all. (sandhi 1.9.0 peer address.)
    if (_rl_allow(sandhi_server_conn_peer_ip(conn)) == 0) {
        return resp_json_err(conn, "429 Too Many Requests", "too many sign-in attempts from this address");
    }
    # 2. Global concurrency cap — bounds how much of the worker pool Argon2id can hold at
    #    once, including across many distinct sources.
    var n = atomic_fetch_add(&g_login_inflight, 1);
    if (n >= LOGIN_MAX_INFLIGHT) {
        atomic_fetch_add(&g_login_inflight, 0 - 1);
        return resp_json_err(conn, "429 Too Many Requests", "too many concurrent sign-in attempts");
    }
    var rc = _handle_login_inner(ctx, conn, buf, blen, params);
    atomic_fetch_add(&g_login_inflight, 0 - 1);
    return rc;
}

fn _handle_login_inner(ctx, conn, buf, blen, params): i64 {
    var bptr = http_body_ptr(buf, blen);
    var bln = http_body_len(buf, blen);
    if (bptr == 0 || bln <= 0) { return resp_json_err(conn, "400 Bad Request", "missing request body"); }
    var v = json_v_parse_str(bptr, bln);
    if (v == 0) { return resp_json_err(conn, "400 Bad Request", "invalid JSON"); }
    var pw = json_v_str(json_v_obj_get(v, "password"));
    if (pw == 0) { return resp_json_err(conn, "400 Bad Request", "missing string field 'password'"); }

    # Map the credential to a (subject, role) by Argon2id-verifying against the stored
    # salted tags. Two demo credentials exercise RBAC.
    var sub = 0;
    var role = 0;
    if (_auth_pw_ok(pw, g_admin_salt, g_admin_hash) == 1) {
        sub = "admin"; role = "admin";
    } else {
        if (_auth_pw_ok(pw, g_user_salt, g_user_hash) == 1) {
            sub = "user"; role = "user";
        } else {
            return resp_json_err(conn, "401 Unauthorized", "invalid credentials");
        }
    }

    var ttl = 3600;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("token"),      json_v_str_new(auth_issue(sub, role, ttl)));
    json_v_obj_set(o, str_lit("token_type"), json_v_str_new(str_lit("Bearer")));
    json_v_obj_set(o, str_lit("expires_in"), json_v_int_new(ttl));
    return resp_json(conn, "200 OK", o);
}

# Extract the Bearer token cstr from the request, or 0 if absent/malformed.
fn _bearer_token(buf, blen): i64 {
    var authz = sandhi_server_find_header(buf, blen, "Authorization");
    if (authz == 0) { return 0; }
    if (_starts_with(authz, "Bearer ") == 0) { return 0; }
    return authz + 7;
}

# Request-guard used by protected resource handlers (e.g. note mutations in main.cyr):
# verify the request's Bearer token and return its claims obj (sub/role/…), or 0 when
# the token is absent, malformed, invalid, or expired. On 0 the caller replies 401.
# (Guards the null token — auth_verify_claims walks the cstr and must not see 0.)
fn auth_req_claims(buf, blen): i64 {
    var tok = _bearer_token(buf, blen);
    if (tok == 0) { return 0; }
    return auth_verify_claims(tok);
}

# The verified `role` claim (str) for the request, or 0 if unauthenticated. Lets a
# handler apply RBAC (e.g. `_role_is(auth_req_role(...), "admin")`) without re-parsing.
fn auth_req_role(buf, blen): i64 {
    var v = auth_req_claims(buf, blen);
    if (v == 0) { return 0; }
    return json_v_str(json_v_obj_get(v, "role"));
}

# GET /api/me — requires `Authorization: Bearer <token>`. Returns {sub, role,
# authenticated} on a valid, unexpired token, else 401. The authentication demonstrator.
fn handle_me(ctx, conn, buf, blen, params): i64 {
    var tok = _bearer_token(buf, blen);
    if (tok == 0) { return resp_json_err(conn, "401 Unauthorized", "missing or malformed Authorization header"); }
    var v = auth_verify_claims(tok);
    if (v == 0) { return resp_json_err(conn, "401 Unauthorized", "invalid or expired token"); }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("sub"),           json_v_str_new(json_v_str(json_v_obj_get(v, "sub"))));
    json_v_obj_set(o, str_lit("role"),          json_v_str_new(json_v_str(json_v_obj_get(v, "role"))));
    json_v_obj_set(o, str_lit("authenticated"), json_v_bool_new(1));
    return resp_json(conn, "200 OK", o);
}

# GET /api/admin — RBAC-gated: requires a valid token whose `role` claim is "admin".
# 401 (unauthenticated: no/invalid token) vs 403 (authenticated but wrong role) are
# distinguished — the authentication/authorization split.
fn handle_admin(ctx, conn, buf, blen, params): i64 {
    var tok = _bearer_token(buf, blen);
    if (tok == 0) { return resp_json_err(conn, "401 Unauthorized", "missing or malformed Authorization header"); }
    var v = auth_verify_claims(tok);
    if (v == 0) { return resp_json_err(conn, "401 Unauthorized", "invalid or expired token"); }
    var role = json_v_str(json_v_obj_get(v, "role"));
    if (_role_is(role, "admin") == 0) { return resp_json_err(conn, "403 Forbidden", "requires admin role"); }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_lit("authorized"), json_v_bool_new(1));
    json_v_obj_set(o, str_lit("role"),       json_v_str_new(role));
    json_v_obj_set(o, str_lit("message"),    json_v_str_new(str_lit("admin access granted")));
    return resp_json(conn, "200 OK", o);
}
