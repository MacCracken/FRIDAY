# Dependencies
node_modules/
**/node_modules/

# Build output (binaries, compiled JS, dist/migrations/ SQL copies — all generated by build scripts)
dist/
**/dist/
*.tsbuildinfo

# Build stats / benchmarks
stats/

# Vite / Vitest cache
.vite/
**/.vite/

# Environment and secrets
.env
.env.*
!.env.example
!.env.dev.example
!.env.expanded.example
*.backup

# SQLite databases
*.db
*.db-journal
*.db-wal
*.sqlite

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Rust / Cargo
crates/target/
crates/**/target/

# Lock files
*.lock

# Test coverage
coverage/

# Logs
*.log
pino-*.log

# Email data
.emails/

# Certs
certs/

# License signing key (maintainer only — never commit)
.license-private.pem

# Community skills — managed via bind mount in Docker; lives in secureyeoman-community-repo repo
community-repo/

# Runtime data directory — personality avatars, TLS certs, vector indices, etc.
# This lives in ~/.secureyeoman or $SECUREYEOMAN_DATA_DIR at runtime, never in the repo
data/
